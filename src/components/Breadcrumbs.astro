---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    {items.map((it, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> / </span>}
        {i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </>
    ))}
  </div>
</nav>
