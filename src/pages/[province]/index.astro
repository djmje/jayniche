---
import ContentPage from '../../layouts/ContentPage.astro';
import { citiesIn } from '../../data/cities';
import { situationsFor } from '../../data/situations';
import { localBusinessSchema } from '../../lib/schema';

export function getStaticPaths() {
  return [{ params: { province: 'ontario' } }, { params: { province: 'alberta' } }];
}

const province = Astro.params.province as 'ontario' | 'alberta';
const isOn = province === 'ontario';
const name = isOn ? 'Ontario' : 'Alberta';
const cities = citiesIn(province);
const situations = situationsFor(province);

const title = `We Buy Houses in ${name} | Cash Offer, Any Condition`;
const description = isOn
  ? 'Sell your Ontario house as-is for cash: Toronto, Ottawa, London, Kitchener-Waterloo, Windsor, Sudbury and beyond. No repairs, showings or commissions.'
  : 'Sell your Alberta house as-is for cash: Calgary, Edmonton, Red Deer, Lethbridge and beyond. No repairs, showings or commissions. You pick the closing date.';

const faqs = isOn
  ? [
      { q: 'Do I pay land transfer tax when I sell in Ontario?', a: 'No. In Ontario, land transfer tax is paid by the buyer, not the seller.' },
      { q: 'Do you buy outside the cities listed?', a: 'Yes. We buy across Ontario, including towns and rural properties. Send us the address and we’ll let you know.' },
      { q: 'Can you buy an estate property before probate is done?', a: 'We can agree on terms early, but Ontario says the estate certificate should be in hand before an agreement of purchase and sale is signed. We’ll set the closing for when the estate is ready.' },
    ]
  : [
      { q: 'Is there a land transfer tax in Alberta?', a: 'No. Alberta doesn’t have a land transfer tax. There are Land Titles registration fees, which are normally a buyer cost.' },
      { q: 'Do I need a Real Property Report to sell to you?', a: 'Most Alberta sale contracts ask the seller for one. If yours is missing or out of date, tell us. We can usually work around it.' },
      { q: 'Do you buy outside the cities listed?', a: 'Yes. We buy across Alberta, including towns and acreages. Send us the address and we’ll let you know.' },
    ];
---

<ContentPage
  title={title}
  description={description}
  h1={`We buy houses across ${name}`}
  intro={isOn
    ? 'Sell your Ontario house as-is, for cash, on your timeline. We buy homes that need work, rentals with tenants, inherited houses and homes in complicated situations, from the GTA to Northern Ontario.'
    : 'Sell your Alberta house as-is, for cash, on your timeline. We buy homes that need work, rentals with tenants, inherited houses and homes in complicated situations, from Calgary and Edmonton to smaller centres.'}
  crumbs={[{ name: 'Home', path: '/' }, { name, path: `/${province}/` }]}
  faqs={faqs}
  province={name}
  schema={[localBusinessSchema(description)]}
>
  <section class="section">
    <div class="wrap prose">
      <h2>Cities we buy in</h2>
      <ul class="link-grid">
        {cities.map((c) => <li><a href={`/${province}/${c.slug}/`}>Sell your house in {c.name}</a></li>)}
      </ul>
      <p>Don’t see your town? We buy across {name}. Send us the address.</p>

      <h2>Selling a house in {name}: what’s different</h2>
      {isOn ? (
        <>
          <p>Ontario estates go through the Superior Court of Justice, and the estate usually needs a Certificate of Appointment of Estate Trustee (or a Small Estate Certificate) before the house can be sold. There’s also an Estate Administration Tax on the value above $50,000.</p>
          <p>Lenders here usually use <a href="/ontario/power-of-sale/">power of sale</a> rather than court foreclosure, and it can move quickly. Rental homes are governed by the Residential Tenancies Act and the Landlord and Tenant Board.</p>
        </>
      ) : (
        <>
          <p>Alberta estates go through the Court of King’s Bench, where the personal representative applies for a grant of probate or administration. There’s no estate tax like Ontario’s, just a court filing fee based on the estate’s value.</p>
          <p>Alberta lenders use a court-supervised <a href="/alberta/foreclosure/">foreclosure</a> process with a redemption period, usually six months for most homes. Rentals are governed by the Residential Tenancies Act, with disputes going to the RTDRS or the courts.</p>
        </>
      )}

      <h2>Situations we help with in {name}</h2>
      <ul class="link-grid">
        {situations.map((s) => <li><a href={s.path}>{s.label}</a></li>)}
      </ul>
    </div>
  </section>
</ContentPage>
