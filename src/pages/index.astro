---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, hasPhone } from '../data/site';
import { citiesIn } from '../data/cities';
import { localBusinessSchema, faqSchema } from '../lib/schema';

const title = 'We Buy Houses in Ontario & Alberta | Jay Home Buyers';
const description =
  'Sell your house as-is in Ontario or Alberta. No repairs, no showings, no agent fees. Get a fair cash offer and pick your own closing date.';

const faqs = [
  {
    q: 'Is this a scam, or will I get lowballed?',
    a: 'No. A real person reviews every property before any offer is made, and we explain how we got to the number. You are never obligated to accept, and there is no cost at any stage.',
  },
  {
    q: 'Do I need to clean up or repair anything first?',
    a: 'No. We buy houses as-is, including ones that need a lot of work, still have belongings inside, or haven’t been touched in years.',
  },
  {
    q: 'Will I be pressured on the call?',
    a: 'No. The call is just to understand the property so we can put together a fair number. What you do next is entirely up to you.',
  },
  {
    q: 'Do I have to pay commissions or fees?',
    a: 'No. There are no agent commissions. On homes we buy, we also cover your lawyer fees and the usual closing costs, so the offer you accept is what you walk away with, less anything owing on the property, like your mortgage.',
  },
  {
    q: 'How fast can you close?',
    a: 'You pick the closing date. If you need to move quickly, we work toward that. If you need more time, that works too.',
  },
  {
    q: 'Are you a real estate agent?',
    a: 'No. We are a private buyer, not a brokerage. We don’t list your home or show it to the public. If selling to us isn’t the best fit for your situation, we’ll tell you.',
  },
];

const situations = [
  { label: 'Inherited or estate property', links: [['Ontario', '/ontario/inherited-house/'], ['Alberta', '/alberta/inherited-house/']] },
  { label: 'House needs major repairs, or has fire or water damage', href: '/situations/house-needs-repairs/' },
  { label: 'Tenant-occupied rental', links: [['Ontario', '/ontario/sell-house-with-tenants/'], ['Alberta', '/alberta/sell-house-with-tenants/']] },
  { label: 'Behind on mortgage payments', href: '/situations/behind-on-mortgage/' },
  { label: 'Power of sale (Ontario) or foreclosure (Alberta)', links: [['Power of sale', '/ontario/power-of-sale/'], ['Foreclosure', '/alberta/foreclosure/']] },
  { label: 'Divorce or separation', href: '/situations/divorce/' },
  { label: 'Downsizing', href: '/situations/downsizing/' },
  { label: 'Relocating for work or family', href: '/situations/relocating/' },
];

const schema = [localBusinessSchema(description), faqSchema(faqs)];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-intro">
        <h1>Sell your house as-is in Ontario or Alberta</h1>
        <p class="lead">
          No repairs, no cleanup, no showings. We make a fair cash offer, and you pick the closing date.
        </p>
      </div>
      <div id="form" class="hero-form">
        <LeadForm />
      </div>
      <div class="hero-points">
        <ul class="checks">
          <li>No agent commissions or closing costs</li>
          <li>We cover your lawyer fees</li>
          <li>You choose the closing date</li>
          <li>Every offer reviewed by a real person, not a call centre</li>
          <li>No pressure and no obligation</li>
        </ul>
        {hasPhone && (
          <p class="hero-call">
            Prefer to talk? <a href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How it works</h2>
      <p>You control how far this goes. Fill out the form, have a short call, then decide. No pressure at any point.</p>
      <ol class="steps">
        <li>
          <h3>Tell us about the property</h3>
          <p>A short form: the address, its condition and your timeline. It takes about two minutes.</p>
        </li>
        <li>
          <h3>A short call</h3>
          <p>We call to ask a few follow-up questions about the property so we can put together a fair number.</p>
        </li>
        <li>
          <h3>Review your cash offer</h3>
          <p>A real person reviews every property before we come back to you. If you accept, you pick the closing date.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>Situations we help with</h2>
      <p>
        Every property has a story. An inherited house, a rental that’s become more hassle than it’s worth, a place
        you’re just ready to be done with. The traditional route can take months you may not have or want to spend.
      </p>
      <ul class="tiles">
        {situations.map((s) => (
          <li>
            {s.href ? <a href={s.href}>{s.label}</a> : (
              <>
                {s.label}
                <span class="tile-links">{s.links!.map(([t, h]) => <a href={h}>{t}</a>)}</span>
              </>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Where we buy</h2>
      <p>We buy houses across Ontario and Alberta, in cities, towns and rural areas.</p>
      <div class="areas">
        <div>
          <h3><a href="/ontario/">Ontario</a></h3>
          <ul class="link-grid">{citiesIn('ontario').map((c) => <li><a href={`/ontario/${c.slug}/`}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h3><a href="/alberta/">Alberta</a></h3>
          <ul class="link-grid">{citiesIn('alberta').map((c) => <li><a href={`/alberta/${c.slug}/`}>{c.name}</a></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow">
      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section cta">
    <div class="wrap narrow center">
      <h2>Find out what we can offer</h2>
      <p>No obligation, and a real person reviews every property.</p>
      <a class="btn btn-primary" href="#form">Get my free cash offer</a>
      {hasPhone && <a class="btn btn-outline" href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a>}
    </div>
  </section>
</Base>
