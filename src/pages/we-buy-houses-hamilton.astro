---
// Hamilton landing page at /we-buy-houses-hamilton/. The fuller Hamilton city page is /ontario/hamilton/.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import SmallPrint from '../components/SmallPrint.astro';
import { site, hasPhone } from '../data/site';

const path = '/we-buy-houses-hamilton/';
const title = 'We Buy Houses in Hamilton, ON | Fast Cash Offer | Jay Home Buyers';
const description =
  'Sell your Hamilton house as-is. No repairs, no showings, no agent commissions. Get a fair, no-obligation cash offer and pick your closing date.';
const button = 'Get My Cash Offer';
const areas = ['Hamilton', 'Stoney Creek', 'Ancaster', 'Dundas', 'Waterdown', 'Flamborough', 'Glanbrook', 'Binbrook'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: site.name,
    url: new URL(path, site.url).href,
    image: `${site.url}/og-image.png`,
    description,
    ...(hasPhone && { telephone: site.phoneE164 }),
    ...(site.email && { email: site.email }),
    areaServed: areas.map((name) => ({ '@type': 'City', name })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-intro">
        <h1>We Buy Houses in Hamilton, In Any Condition</h1>
        <p class="lead">Get a fair, no-obligation cash offer. No repairs, no showings, no agent commissions. You pick the closing date.</p>
      </div>
      <div id="form" class="hero-form">
        <LeadForm province="Ontario" buttonText={button} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Selling a Hamilton House Shouldn’t Be Stressful</h2>
      <p>We’re a local Hamilton home buyer. Whether the house needs major work or you just want a simple, private sale, we’ll make you a straightforward offer and walk you through your options with no pressure.</p>

      <h2>We Buy Hamilton Houses in Any Situation</h2>
      <ul>
        <li>Inherited or estate properties</li>
        <li>Houses needing major repairs (foundation, roof, water or fire damage)</li>
        <li>Tenant-occupied rentals and tired landlords</li>
        <li>Divorce, relocation or downsizing</li>
        <li>Facing power of sale or behind on mortgage payments</li>
        <li>Vacant houses or properties with work orders</li>
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>How It Works</h2>
      <ol class="steps">
        <li><h3>Tell us about your property.</h3><p>Fill out the form; it takes about a minute.</p></li>
        <li><h3>Get a fair cash offer.</h3><p>We’ll look at the house and give you a no-obligation offer.</p></li>
        <li><h3>Pick your closing date and get paid through a real estate lawyer.</h3></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Why Sell to Jay Home Buyers</h2>
      <ul>
        <li>No repairs or cleaning. Sell exactly as-is</li>
        <li>No showings or open houses</li>
        <li>No agent commissions</li>
        <li>Close on your timeline, a few weeks or a few months out</li>
      </ul>

      <h2>Areas We Serve</h2>
      <p>Hamilton, Stoney Creek, Ancaster, Dundas, Waterdown, Flamborough, Glanbrook, Binbrook and the Hamilton Mountain.</p>
      <p>More about selling in Hamilton: <a href="/ontario/hamilton/">our Hamilton guide</a>.</p>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Ready to see what your Hamilton house is worth to us?</h2>
      <a class="btn btn-primary" href="#form">{button}</a>
    </div>
  </section>

  <SmallPrint />
</Base>
