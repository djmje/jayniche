// Cloudflare Workers config: serves the built Astro site (the dist folder) on jayniche.ca.
// Cloudflare reads this on every build from GitHub. Pushes to `main` go live;
// other branches get a preview link.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jayniche",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-08",
  // Build the site before every deploy, so it works even if Cloudflare's
  // "Build command" setting is left blank.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Let worker/index.js see every request first, for the www and https redirects.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "jayniche.ca", "custom_domain": true },
    { "pattern": "www.jayniche.ca", "custom_domain": true }
  ],
  "preview_urls": true,
  // Needed by `wrangler preview`, which Cloudflare uses to build preview links.
  "previews": {}
}
