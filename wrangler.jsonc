// Cloudflare Workers config: serves the built Astro site (the dist folder) as static files.
// Cloudflare reads this on every build from GitHub.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jayniche",
  "compatibility_date": "2026-10-08",
  // Build the site before every deploy, so it works even if Cloudflare's
  // "Build command" setting is left blank.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true
}
